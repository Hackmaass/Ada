# ─── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
# Model to use for LLM calls (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ─── GitHub ───────────────────────────────────────────────
# Optional: personal access token for higher rate limits.
# If omitted, the service falls back to unauthenticated REST API requests.
GITHUB_TOKEN=ghp_your-github-personal-access-token

# ─── PDF Parser ───────────────────────────────────────────
# Which library to use for PDF text extraction.
# Options: "pdfplumber" (default) or "fitz" (PyMuPDF)
PDF_PARSER=pdfplumber
